record(int64in, "$(P)$(R)Timestamp") {
    field(DESC, "microseconds since last hardware reset")
    field(DTYP, "stream")
    field(INP,  "@TriggerCounter.proto getTimestamp $(PORT)")
    field(EGU,  "us")
    field(SCAN, "I/O Intr")
}

record(int64in, "$(P)$(R)Counter") {
    field(DESC, "number of triggers since last hw reset")
    field(DTYP, "stream")
    field(INP,  "@TriggerCounter.proto getCounter $(PORT)")
    field(EGU,  "counts")
    field(SCAN, "I/O Intr")
}

record(stringout, "$(P)$(R)Reset") {
    field(DESC, "reset counter and timestamp")
    field(DTYP, "stream")
    field(OUT, "@TriggerCounter.proto reset $(PORT)")
    field(SCAN, "Passive")
}
