< envPaths
errlogInit(20000)

dbLoadDatabase("$(TOP)/dbd/spinnakerApp.dbd")
spinnakerApp_registerRecordDeviceDriver(pdbbase) 

# Common to all cameras
#################################################################################################################################################
# Prefix for all records
epicsEnvSet("PREFIX", "Electrons:")

# Really large queue so we can stream to disk at full camera speed
epicsEnvSet("QSIZE",  "200")   
# The maximim image width; used for row profiles in the NDPluginStats plugin
epicsEnvSet("XSIZE",  "2048")
# The maximim image height; used for column profiles in the NDPluginStats plugin
epicsEnvSet("YSIZE",  "1536")
# The maximum number of time series points in the NDPluginStats plugin
epicsEnvSet("NCHANS", "2048")
# The maximum number of frames buffered in the NDPluginCircularBuff plugin
epicsEnvSet("CBUFFS", "500")
# The search path for database files
epicsEnvSet("EPICS_DB_INCLUDE_PATH", "$(ADCORE)/db:$(ADGENICAM)/db:$(ADSPINNAKER)/db")
# Define NELEMENTS to be enough for a 2048x1536x1 monochrome image
epicsEnvSet("NELEMENTS", "3145728")
# FLIR_BFS_31S4M.template
epicsEnvSet("GENICAM_DB_FILE", "$(ADGENICAM)/db/FLIR_BFS_31S4M.template")

# Camera-specific parameters
#################################################################################################################################################
epicsEnvSet("PORT_ESpecLE", "Spectrometer:LowEnergy")
epicsEnvSet("CAMERA_ID_ESpecLE", "20541743")

epicsEnvSet("PORT_ESpecHE", "Spectrometer:HighEnergy")
epicsEnvSet("CAMERA_ID_ESpecHE", "20125390")

epicsEnvSet("PORT_ESpecPoint", "Spectrometer:Pointing")
epicsEnvSet("CAMERA_ID_ESpecPoint", "20057635")

# Settings for Electron Spectrometer Low Energy Screen Camera
#################################################################################################################################################
ADSpinnakerConfig($(PORT_ESpecLE), $(CAMERA_ID_ESpecLE))
asynSetTraceIOMask($(PORT_ESpecLE), 0, 2)
dbLoadRecords("$(TOP)/iocBoot/iocFLIRCamera/template/Electrons-Spectrometer.template", "P=$(PREFIX),R=$(PORT_ESpecLE):,PORT=$(PORT_ESpecLE)")

# Create a standard arrays plugin
NDStdArraysConfigure("$(PREFIX)$(PORT_ESpecLE):Image", 5, 0, "$(PORT_ESpecLE)", 0, 0)
# Use this line for 8-bit or 16-bit data
dbLoadRecords("$(ADCORE)/db/NDStdArrays.template", "P=$(PREFIX),R=$(PORT_ESpecLE):Image:,PORT=$(PREFIX)$(PORT_ESpecLE):Image,ADDR=0,TIMEOUT=1,NDARRAY_PORT=$(PORT_ESpecLE),TYPE=Int16,FTVL=SHORT,NELEMENTS=$(NELEMENTS)")

# Settings for Electron Spectrometer High Energy Screen Camera
#################################################################################################################################################
ADSpinnakerConfig($(PORT_ESpecHE), $(CAMERA_ID_ESpecHE))
asynSetTraceIOMask($(PORT_ESpecHE), 0, 2)
dbLoadRecords("$(TOP)/iocBoot/iocFLIRCamera/template/Electrons-Spectrometer.template", "P=$(PREFIX),R=$(PORT_ESpecHE):,PORT=$(PORT_ESpecHE)")

# Settings for Electron Spectrometer Pointing Screen Camera
#################################################################################################################################################
ADSpinnakerConfig($(PORT_ESpecPoint), $(CAMERA_ID_ESpecPoint))
asynSetTraceIOMask($(PORT_ESpecPoint), 0, 2)
dbLoadRecords("$(TOP)/iocBoot/iocFLIRCamera/template/Electrons-Spectrometer.template", "P=$(PREFIX),R=$(PORT_ESpecPoint):,PORT=$(PORT_ESpecPoint)")

# Starting plugins and the IOC
#################################################################################################################################################
# Load NDPluginPva plugin (see ADCore/iocBoot/commonPlugins.cmd for more plugins)
# NDPvaConfigure(const char *portName, int queueSize, int blockingCallbacks, const char *NDArrayPort, int NDArrayAddr, const char *pvName, size_t maxMemory, int priority, int stackSize) 
# NDPvaConfigure("PVA1", $(QSIZE), 0, "$(PORT_ESpecLE)", 0, $(PREFIX)Pva1:Image, 0, 0, 0)
# dbLoadRecords("NDPva.template",  "P=$(PREFIX),R=Pva1:, PORT=PVA1,ADDR=0,TIMEOUT=1,NDARRAY_PORT=$(PORT_ESpecLE)")
# Must start PVA server if this is enabled
# startPVAServer

set_requestfile_path("$(ADGENICAM)/GenICamApp/Db")
set_requestfile_path("$(ADSPINNAKER)/spinnakerApp/Db")

iocInit()

# save things every thirty seconds
create_monitor_set("auto_settings.req", 30,"P=$(PREFIX)")

# Wait for enum callbacks to complete
epicsThreadSleep(1.0)

# Wait for callbacks on the property limits (DRVL, DRVH) to complete
epicsThreadSleep(1.0)


