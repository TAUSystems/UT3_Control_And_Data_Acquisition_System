
# Prefix for all records
epicsEnvSet("PREFIX", "E:")

# Really large queue so we can stream to disk at full camera speed
epicsEnvSet("QSIZE",  "200")   
# The maximim image width; used for row profiles in the NDPluginStats plugin
epicsEnvSet("XSIZE",  "2048")
# The maximim image height; used for column profiles in the NDPluginStats plugin
epicsEnvSet("YSIZE",  "1536")
# The maximum number of time series points in the NDPluginStats plugin
epicsEnvSet("NCHANS", "2048")
# The maximum number of frames buffered in the NDPluginCircularBuff plugin
epicsEnvSet("CBUFFS", "500")
# The search path for database files
# This is for Linux
epicsEnvSet("EPICS_DB_INCLUDE_PATH", "$(ADCORE)/db:$(ADGENICAM)/db:$(ADSPINNAKER)/db")
# Define NELEMENTS to be enough for a 2048x2048x3 (color) image
epicsEnvSet("NELEMENTS", "3145728")

####################################################################################################################
# The port name for the detector
epicsEnvSet("PORT",   "Spectrometer:Pointing")
ADSpinnakerConfig("$(PORT)", "20057635")
asynSetTraceIOMask($(PORT), 0, 2)

# Main database.  This just loads and modifies ADBase.template
dbLoadRecords("$(ADSPINNAKER)/db/spinnaker.template", "P=$(PREFIX),R=$(PORT):,PORT=$(PORT)")

# Load the autogenerated file of GenICam features
dbLoadRecords("$(GENICAM_DB_FILE)", "P=$(PREFIX),R=$(PORT):,PORT=$(PORT)")

# NDPva
NDPvaConfigure("$(PORT):PVA", $(QSIZE), 0, "$(PORT)", 0, $(PREFIX)Pva:$(PORT):Image, 0, 0, 0)
dbLoadRecords("NDPva.template",  "P=$(PREFIX),R=Pva:$(PORT):, PORT=$(PORT):PVA,ADDR=0,TIMEOUT=1,NDARRAY_PORT=$(PORT)")

####################################################################################################################
# The port name for the detector
epicsEnvSet("PORT",   "Spectrometer:LowEnergy")
ADSpinnakerConfig("$(PORT)", "20541743")
asynSetTraceIOMask($(PORT), 0, 2)

# Main database.  This just loads and modifies ADBase.template
dbLoadRecords("$(ADSPINNAKER)/db/spinnaker.template", "P=$(PREFIX),R=$(PORT):,PORT=$(PORT)")
# Load the autogenerated file of GenICam features
dbLoadRecords("$(GENICAM_DB_FILE)", "P=$(PREFIX),R=$(PORT):,PORT=$(PORT)")

# NDPva
NDPvaConfigure("$(PORT):PVA", $(QSIZE), 0, "$(PORT)", 0, $(PREFIX)Pva:$(PORT):Image, 0, 0, 0)
dbLoadRecords("NDPva.template",  "P=$(PREFIX),R=Pva:$(PORT):, PORT=$(PORT):PVA,ADDR=0,TIMEOUT=1,NDARRAY_PORT=$(PORT)")

####################################################################################################################
# The port name for the detector
epicsEnvSet("PORT",   "Spectrometer:HighEnergy")
ADSpinnakerConfig("$(PORT)", "20125390")
asynSetTraceIOMask($(PORT), 0, 2)

# Main database.  This just loads and modifies ADBase.template
dbLoadRecords("$(ADSPINNAKER)/db/spinnaker.template", "P=$(PREFIX),R=$(PORT):,PORT=$(PORT)")

# Load the autogenerated file of GenICam features
dbLoadRecords("$(GENICAM_DB_FILE)", "P=$(PREFIX),R=$(PORT):,PORT=$(PORT)")

# NDPva
NDPvaConfigure("$(PORT):PVA", $(QSIZE), 0, "$(PORT)", 0, $(PREFIX)Pva:$(PORT):Image, 0, 0, 0)
dbLoadRecords("NDPva.template",  "P=$(PREFIX),R=Pva:$(PORT):, PORT=$(PORT):PVA,ADDR=0,TIMEOUT=1,NDARRAY_PORT=$(PORT)")

####################################################################################################################
set_requestfile_path("$(ADGENICAM)/GenICamApp/Db")
set_requestfile_path("$(ADSPINNAKER)/spinnakerApp/Db")

# Must start PVA server for NDPva
startPVAServer

iocInit()

# save things every thirty seconds
create_monitor_set("auto_settings.req", 30,"P=$(PREFIX)")

# Wait for enum callbacks to complete
epicsThreadSleep(1.0)

# Wait for callbacks on the property limits (DRVL, DRVH) to complete
epicsThreadSleep(1.0)

dbpf $(PREFIX)Pva:Spectrometer:Pointing:EnableCallbacks 1
dbpf $(PREFIX)Pva:Spectrometer:LowEnergy:EnableCallbacks 1
dbpf $(PREFIX)Pva:Spectrometer:HighEnergy:EnableCallbacks 1
