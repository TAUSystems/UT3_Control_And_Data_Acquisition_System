# Contains records for the ICT device read out through the PicoScope
record(waveform, "$(P)$(R)Trace") {
    field(DESC, "ICT waveform trace")
    field(NELM, "$(NPOINTS)")
    field(FTVL, "FLOAT")
    field(INP, "$(P)$(R)Waveform_$(C)_RBV CP")
    field(EGU, "uV")
}

# ICT-122-070-05:1
# 5 V*s/C
record(ai, "$(P)$(R)Sensitivity") {
    field(DESC, "Voltage response per charge/time")
    field(EGU, "V*s/C")
    field(VAL, 5.0)
}

# inputs:
#   AA: waveform, in microvolts
#   A: time between samples, in picoseconds
#   B: voltage per charge/time, in V*s/C
record(aCalcout, "$(P)$(R)Charge") {
    field(DESC, "Charge")
    field(CALC, "A*1e-12 / B * (SUM(AA) - DBL(AA)) * 1e-6 / 1e-12")
    field(INAA, "$(P)$(R)Trace CP")
    field(INPA, "$(P)$(R)SampleLength_RBV")
    field(INPB, "$(P)$(R)Sensitivity")
    field(EGU, "pC")
    field(PREC, "6")
}
