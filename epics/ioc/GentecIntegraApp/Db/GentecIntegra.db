# # # Display
# 01 Manually sets the scale
# This command is used to force the display of the current data into a specific scale.
# The lower scale is always zero, the higher scales can be found below.
# The autoscale mode applies the best scale for the current values in real time.
# The parameter must be one of the identifiers in the table below and have two digits.
# 
# The index-to-scale mapping is:
#   0  1 picowatt or picojoule
#   1  3 picowatts of picojoules
#   2  10 picowatts or picojoules
#   3  30 picowatts or picojoules
#   ...
#   40 100 megawatts or megajoules
#   41 300 megawatts or megajoules
# or roughly: scale = 10^(index/2 - 12) watts or joules
record(longout, "$(P)$(R)ScaleIndex") {
    field(DESC, "Set display scale")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setScale $(PORT)")
    field(SCAN, "Passive")
    field(DRVL, 0)
    field(DRVH, 41)
    field(FLNK, "$(P)$(R)ScaleIndex_RBV.PROC")
}

# 02 Changes scale to the next higher scale
record(bo, "$(P)$(R)ScaleUp") {
    field(DESC, "Change display scale up")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setScaleUp $(PORT)")
    field(SCAN, "Passive")
}

# 03 Changes scale to the next lower scale
record(bo, "$(P)$(R)ScaleDown") {
    field(DESC, "Change display scale down")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setScaleDown $(PORT)")
    field(SCAN, "Passive")
}

# 04 Returns scale index between 0 and 41
# See the 01 setScale command for the index-to-scale mapping.
record(longin, "$(P)$(R)ScaleIndex_RBV") {
    field(DESC, "Get display scale index")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getCurrentScaleIndex $(PORT)")
    field(SCAN, "Passive")
}

# 05 Sets the autoscale
# 0: Off, 1: On
record(bo, "$(P)$(R)Autoscale") {
    field(DESC, "Set autoscale on/off")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setAutoscale $(PORT)")
    field(SCAN, "Passive")
    field(FLNK, "$(P)$(R)Autoscale_RBV.PROC")
}

# 06 Returns autoscale status
# 0: Off, 1: On
record(bi, "$(P)$(R)Autoscale_RBV") {
    field(DESC, "Get autoscale status")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getAutoscale $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "Off")
    field(ONAM, "On")
}

# # 07 Displays the valid scales for the connected head
# This command is used to display all of the valid scales the connected head supports. The scales are 
# displayed in the scale index.
# displayValidScales {
#     out "*DVS";
#     in "%s";
# }

# 08 Sets the internal trigger level for pulse energy
# This command sets the internal trigger level when using the device in energy mode.
# Trigger level is in percentage from 0.1 to 99.9 and must be 4 numerical values
# including the decimal point.
record(ao, "$(P)$(R)TriggerLevel") {
    field(DESC, "Set trigger level in percent")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setTriggerLevel $(PORT)")
    field(EGU, "%")
    field(DRVL, 0.1)
    field(DRVH, 99.9)
    field(SCAN, "Passive")
    field(FLNK, "$(P)$(R)TriggerLevel_RBV.PROC")
}


# 09 Returns trigger level value, in percent
# This is for joulemeters and wattmeters in energy mode only.
record(ai, "$(P)$(R)TriggerLevel_RBV") {
    field(DESC, "Get trigger level in percent")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getTriggerLevel $(PORT)")
    field(SCAN, "Passive")
    field(EGU, "%")
}

# 10 Returns the current measure mode on INTEGRA
# POWER = 0, ENERGY = 1, SSE = 2
# This command returns the INTEGRA’s measurement mode. Depending on the head, it can be power mode in W, 
# energy mode in J or single shot energy mode in J (SSE).
record(mbbi, "$(P)$(R)MeasureMode") {
    field(DESC, "Get current measure mode")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getMeasureModeDisplay $(PORT)")
    field(SCAN, "Passive")
    field(ZRST, "POWER")
    field(ONST, "ENERGY")
    field(TWST, "SSE")
}

# # # Measurement
# # Data acquisition
# 11 Gets the value currently in ASCII or binary
# This command is used to query the value that is currently being displayed by the monitor. The value is 
# displayed in watts or in joules. For joulemeters, the data can also be in binary format
record(ai, "$(P)$(R)Energy") {
    field(DESC, "Get energy value")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto queryCurrentValueASCII $(PORT)")
    field(EGU, "Joule")
    field(SCAN, "Passive")
}

# # 12 Sends the values in ASCII or binary to the serial port with the data sampling setting
# This command is used to send data to the serial port, according to the data sampling setting. 
# For joulemeters, the data can also be in binary format
# sendContinuousTransmissionASCII {
#     out "*CAU";
#     in "OK";
# }

# sendContinuousTransmissionBinary {
#     out "*CAU";
#     in "xxx";
# }

# # 13 Sends continuous value with period in ASCII or binary
# INTEGRA will send continuous energy data and the pulse repetition rate in Hz. They are comma-separated.
# This is for joulemeters only. For joulemeters, the data can also be in binary format
# sendContinuousValueWithPeriodASCII {
#     out "*CEU %d";
#     in "OK";
# }

# sendContinuousValueWithPeriodBinary {
#     out "*CEU %d";
#     in "xxx";
# }

# # 14 Sends current value with frequency in ASCII or binary
# INTEGRA will send the current measurement and the pulse repetition rate in Hz. They are comma-separated. 
# This is for joulemeters only. For joulemeters, the data can also be in binary format
# sendCurrentValueWithFrequencyASCII {
#     out "*CTU %d";
#     in "OK";
# }

# sendCurrentValueWithFrequencyBinary {
#     out "*CTU %d";
#     in "xxx";
# }

# 15 Stops the *CAU and *CEU commands
# This command is used to stop the real-time transfer enabled by the CAU and CEU commands
record(bo, "$(P)$(R)StopContinuousCommands") {
    field(DESC, "Stop continuous commands")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto stopContinuousCommands $(PORT)")
    field(SCAN, "Passive")
}

# 16 Determines if new reading is available or not
# This command is used to check whether a new value is available from the device. Though optional, 
# its use is recommended when used with a single pulse operation.
# This is for joulemeters only.
record(bi, "$(P)$(R)NewValueReady") {
    field(DESC, "Query if new value is ready")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto queryNewValueReady $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "NotReady")
    field(ONAM, "Ready")
}

# 17 Sends the laser rep rate frequency in ASCII
# This is for joulemeters only.
record(ai, "$(P)$(R)LaserFrequency") {
    field(DESC, "Get laser rep rate frequency")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getLaserFrequency $(PORT)")
    field(SCAN, "Passive")
    field(EGU, "Hz")
}

# 18 Sets the binary joulemeter mode or ASCII mode
# 0 = ASCII mode, 1 = Binary mode
# This is for joulemeters only.
record(bo, "$(P)$(R)BinaryJoulemeterMode") {
    field(DESC, "Set joulemeter binary or ASCII mode")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setBinaryJoulemeterMode $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "ASCII")
    field(ONAM, "Binary")
    field(FLNK, "$(P)$(R)BinaryJoulemeterMode_RBV.PROC")
}

# 19 Returns the binary joulemeter mode or ASCII mode
# This is for joulemeters only.
record(bi, "$(P)$(R)BinaryJoulemeterMode_RBV") {
    field(DESC, "Get joulemeter binary or ASCII mode")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getBinaryJoulemeterMode $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "ASCII")
    field(ONAM, "Binary")
}

# # Setup
# 20 Specifies the wavelength in nm
# This command is used to specify the wavelength in nm being used on the detector. The EEPROM in the 
# detector contains measured spectral data for a wide range of wavelengths. A valid value is set between 
# the lowest and highest wavelengths supported by the device, and it should not be a floating point value. 
# The input parameter must have five digits. If the desired wavelength does not have five digits, you must 
# enter a zero-padded number. For example, to set the wavelength at 514 nm, you must enter 00514.
# In the new series, specifying zero as a wavelength or providing an out-of-bound value as a parameter cancels 
# the command. 
record(longout, "$(P)$(R)Wavelength") {
    field(DESC, "Set personal wavelength correction in nm")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setPersonalWavelengthCorrectionNM $(PORT)")
    field(EGU, "nm")
    field(SCAN, "Passive")
    field(DRVL, 0)
    field(DRVH, 99999)
    field(FLNK, "$(P)$(R)PersonalWavelengthCorrectionNM_RBV.PROC")
}

# 21 Specifies the wavelength in microns (for THZ heads only)
# This command is used to specify the wavelength in microns for THZ detectors only. The EEPROM in the detector 
# contains measured spectral data for a wide range of wavelengths. A valid value is set between the lowest and 
# highest wavelengths supported by the device. The input parameter must have five digits and can be a floating 
# point value. If the desired wavelength does not have five digits, you must enter a zero-padded number. For 
# example, to set the wavelength at 10.6 microns, you must enter 010.6. Please note that the resolution is 
# limited as follows: 
#   Wavelength range; Resolution limit 
#   Less than 100 μm; # 10 nm 
#   Greater than 99.99 μm or less than 1000 μm; 100 nm 
#   Greater than 999.9um; 1 μm
# In the new series, specifying zero as a wavelength or providing an out-of-bound value as a parameter cancels 
# the command.

# Not necessary. 


# 22 Returns the wavelength in nm
record(longin, "$(P)$(R)Wavelength_RBV") {
    field(DESC, "Get personal wavelength correction in nm")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getWavelength $(PORT)")
    field(SCAN, "Passive")
    field(EGU, "nm")
}

# # Control
# 23 Turns the anticipation on or off
# 0: Off, 1: On
# This command is used to enable or disable the anticipation processing when the device is reading from a 
# wattmeter. The anticipation is a software-based acceleration algorithm that provides faster readings 
# using the detector’s calibration.
record(bo, "$(P)$(R)Anticipation") {
    field(DESC, "Set anticipation on/off")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setAnticipation $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(FLNK, "$(P)$(R)Anticipation_RBV.PROC")
}

# 24 Returns the anticipation status
# 0: Off, 1: On
record(bi, "$(P)$(R)Anticipation_RBV") {
    field(DESC, "Get anticipation status")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getAnticipationStatus $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "Off")
    field(ONAM, "On")
}

# 25 Applies the noise suppression algorithm
# Sets or queries the sampling size of the noise suppression. For pyroelectric detectors and UM detectors only.
# The INTEGRA joulemeter instrument has a special proprietary algorithm that can lower the noise-induced error
# when reading low energy levels or energy readings of any level with noise present. This feature greatly reduces
# the effect of noise on the peak-to-peak measurement in joulemeter mode. INTEGRA will need to measure the number
# of pulses selected in the sampling size before the algorithm will settle to the noise-suppressed value. Once the
# readings have stabilized, any subsequent reading will be stable until the sampling size is changed. The system
# will then stabilize to the new value. Larger sampling sizes will result in more noise suppression. Noise suppression
# works best with the external trigger. This function will greatly improve the accuracy of the lowest scale, or any
# scale, when used in a noisy environment.
record(longout, "$(P)$(R)NoiseSuppression") {
    field(DESC, "Set noise suppression sampling size")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setNoiseSuppression $(PORT)")
    field(SCAN, "Passive")
    field(DRVL, 0)
    field(DRVH, 999)
}

# # 26 Zeroes the reading for a power detector
# This command subtracts the current value from all future measurements the moment the command is issued to set a new 
# zero point. This command does not work with photodiodes. Please refer to *SDZ.
# Returns "Please Wait..." and "Done!" if in autoscale, nothing when in fixed scale.
# setZeroOffset {
#     out "*SOU";
# }

# 27 Undoes the zeroing of the reading for a power detector
# This command undoes the zero offset command to set the zero point at zero.
record(bo, "$(P)$(R)ClearZeroOffset") {
    field(DESC, "Clear zero offset for power detector")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto clearZeroOffset $(PORT)")
    field(SCAN, "Passive")
}

# 28 Returns the zero offset status
# This command returns whether the zero offset has been activated or not. 
# 0: Off, 1: On
record(bi, "$(P)$(R)ZeroOffset_RBV") {
    field(DESC, "Get zero offset status")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getZeroOffset $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "Off")
    field(ONAM, "On")
}

# 29 Zeroes the reading for all the scales for a photo detector
# This command subtracts the current value for all available scales from all future measurements the moment the command 
# is issued to set a new zero point.
# This is for photodiodes only. Please refer to *SOU for other detectors.
# Returns "Please Wait..." and "Done!" if in autoscale, nothing when in fixed scale.
# setDiodeZeroOffset {
#     out "*SDZ";
# }

# 30 Sets the multiplier value
# This command is used to set the value of the multipliers.
record(ao, "$(P)$(R)UserMultiplier") {
    field(DESC, "Set user multiplier value")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setUserMultiplier $(PORT)")
    field(SCAN, "Passive")
    field(FLNK, "$(P)$(R)UserMultiplier_RBV.PROC")
}

# 31 Returns the current multiplier value
record(ai, "$(P)$(R)UserMultiplier_RBV") {
    field(DESC, "Get user multiplier value")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getUserMultiplier $(PORT)")
    field(SCAN, "Passive")
}

# 32 Sets the offset value, a eight-character numerical value
record(ao, "$(P)$(R)UserOffset") {
    field(DESC, "Set user offset value")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setUserOffset $(PORT)")
    field(SCAN, "Passive")
    field(FLNK, "$(P)$(R)UserOffset_RBV.PROC")
}

# 33 Returns the current offset value
record(ai, "$(P)$(R)UserOffset_RBV") {
    field(DESC, "Get user offset value")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getUserOffset $(PORT)")
    field(SCAN, "Passive")
}

# 34 Sets the single shot energy mode
# 0: Off, 1: On
record(bo, "$(P)$(R)SingleShotEnergyMode") {
    field(DESC, "Set single shot energy mode on/off")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setSingleShotEnergyMode $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(FLNK, "$(P)$(R)MeasureMode.PROC")
}

# 35 Sets the attenuator
# 0: Off, 1: On
record(bo, "$(P)$(R)Attenuator") {
    field(DESC, "Set attenuator on/off")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setAttenuator $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(FLNK, "$(P)$(R)Attenuator_RBV.PROC")
}

# 36 Returns the attenuator status
# If the attenuator is not available, it will always be off.
record(bi, "$(P)$(R)Attenuator_RBV") {
    field(DESC, "Get attenuator status")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto getAttenuator $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "Off")
    field(ONAM, "On")
}

# 37 Activates or deactivates the external trigger
# for INTEGRAs which have an external trigger option.
# 0: Off, 1: On
record(bo, "$(P)$(R)ExternalTrigger") {
    field(DESC, "Set external trigger on/off")
    field(DTYP, "stream")
    field(OUT,  "@GentecIntegra.proto setExternalTrigger $(PORT)")
    field(SCAN, "Passive")
    field(ZNAM, "Off")
    field(ONAM, "On")
}

# # # Instrument and detector information
# 38 Sets the baud rate for RS-232
# This command is used to default baud rate of the INTEGRA for RS-232 only.
# This will permanently change the baud rate and save it in the INTEGRA flash memory.
# If you want to change it back, you will have to send the command again at the new baud rate.
# If you want to update the INTEGRA firmware, you will have to change the baud rate to 115200.
#   0: 9600
#   1: 19200
#   2: 38400
#   3: 57600
#   4: 115200
# Returns new baud rate
# setBaudRate {
#     out "*BPS%1d";
#     in "ACK: %d";
# }

# TODO. 

# 39 Gets firmware version of the monitor
record(stringin, "$(P)$(R)Version") {
    field(DESC, "Get device type and firmware version")
    field(DTYP, "stream")
    field(INP,  "@GentecIntegra.proto queryVersion $(PORT)")
    field(SCAN, "Passive")
}

# 40 Retrieves the detector information and monitor settings
# This command is used to query the device to get information about the following characteristics:
#   Measure mode
#   Maximum, minimum and current scale
#   Maximum, minimum and current wavelength with and without attenuation
#   Attenuator availability and status
#   Detector model
#   Detector serial number
# Returns a hexadecimal structure with the following fields: 
# The first byte represents the validity of the structure: 0 represents a valid line while 1 is the end of the structure.
# The next 4 bytes represent the address line, and the last 4 bytes are the actual value.
# The values are written on 32 bits, which means that all the values are written on two lines.
# The first line represents the LSB, and the second line represents the MSB.
# Note that text data values such as detector name and serial number are in ASCII-encoded little-endian 16-bit chunks.
# The byte order must be reversed to be converted into a readable format.
# See table in the manual for the address line and value mapping.
# queryStatus {
#     out "*STS";
#     in "%s";
# }

# TODO.

