include "PreparingTimeout.db"

# Start Burst
# When Status changes to Preparing, start acquisition on cameras
record(calcout, TakeNShots:TriggerGenerationPreparing) {
  field(DESC, "Acts when Status changes to Preparing")
# Timing:TriggerGeneration:Status == Preparing
  field(CALC, "A == 2")
  field(INPA, "Timing:TriggerGeneration:Status CP")
  field(OUT, "TakeNShots:PreparingSeq.PROC")
  field(OOPT, "Transition To Non-zero")
}

record(seq, TakeNShots:PreparingSeq) {
  field(DESC, "Take actions when Status Preparing")
# start acquisition on cameras
  field(LNK0, "TakeNShots:CameraAcquisitionStartFanOut.PROC")
  field(DOL0, "1")
# start timeout timer
  field(LNK1, "TakeNShots:PreparingTimeout:StartTimer.PROC")
  field(DOL1, "1")
}

record(dfanout, TakeNShots:CameraAcquisitionStartFanOut) {
  field(DESC, "Start acquisition on cameras")
  field(OUTA, "E:Spectrometer:Pointing:Acquire PP")
  field(OUTB, "E:Spectrometer:LowEnergy:Acquire PP")
  field(OUTC, "E:Spectrometer:HighEnergy:Acquire PP")
  field(DOL, "1")
  field(SCAN, "Passive")
}

# Wait for cameras to all be in acquisition mode.
record(calc, TakeNShots:CheckCamerasAcquiring) {
  field(DESC, "Check all cameras are in Acquiring mode")
  field(CALC, "A && B && C")
  field(INPA, "E:Spectrometer:Pointing:Acquire_RBV CP")
  field(INPB, "E:Spectrometer:LowEnergy:Acquire_RBV CP")
  field(INPC, "E:Spectrometer:HighEnergy:Acquire_RBV CP")
}

# At the same time, a new Burst and Shots should be written to the measurement 
# database by the data_uploader client. Wait for this to complete.
record(bo, TakeNShots:BurstInDB) {
  field(DESC, "Burst and Shots are ready in meas DB")
  field(VAL, "0")
}

record(calcout, TakeNShots:CheckReadyToArm) {
  field(DESC, "When ready, run Arm sequence")
# Timing:TriggerGeneration:Status == Preparing
  field(CALC, "(A == 2) && B && C")
  field(INPA, "Timing:TriggerGeneration:Status CP")
  field(INPB, "TakeNShots:CheckCamerasAcquiring CP")
  field(INPC, "TakeNShots:BurstInDB CP")
  field(OUT, "TakeNShots:ArmSeq.PROC")
  field(OOPT, "Transition To Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "1")
}

record(seq, TakeNShots:ArmSeq) {
# Set Timing:TriggerGeneration:Status to Armed
  field(LNK0, "Timing:TriggerGeneration:Status")
  field(DOL0, "3")
# Reset BurstInDB to 0
  field(LNK1, "TakeNShots:BurstInDB")
  field(DOL1, "0")
}

# ## Stop Burst
record(calcout, TakeNShots:TriggerGenerationIdle) {
  field(DESC, "Acts when Status changes to non-running")
# Timing:TriggerGeneration:Status = Disconnected, Idle
  field(CALC, "A == 0 || A == 1")
  field(INPA, "Timing:TriggerGeneration:Status CP")
  field(OUT, "TakeNShots:IdleSeq.PROC")
  field(OOPT, "Transition To Non-zero")
}

record(seq, TakeNShots:IdleSeq) {
  field(DESC, "Take actions when Status turns Idle")
  field(LNK0, "TakeNShots:CameraAcquisitionStopFanOut.PROC")
  field(DOL1, "0")
}

record(dfanout, TakeNShots:CameraAcquisitionStopFanOut) {
  field(DESC, "Stop acquisition on cameras")
  field(OUTA, "E:Spectrometer:Pointing:Acquire PP")
  field(OUTB, "E:Spectrometer:LowEnergy:Acquire PP")
  field(OUTC, "E:Spectrometer:HighEnergy:Acquire PP'")
  field(DOL, "0")
}

record(ao, TakeNShots:PreparingTimeout:Time) {
  field(DESC, "Time in sec before Preparing times out")
  field(VAL, "10")
  field(OUT, "TakeNShots:PreparingTimeout:StartTimer.DLY1")
}

record(bo, TakeNShots:PreparingTimeout:HasTimedOut) {
  field(OSV, "MINOR")
}


record(calcout, TakeNShots:PreparingTimeout:Check) {
# Check that Status == Preparing and only one timer is running. (if more than 
# one timer is running, this is likely a check scheduled from a previous, no longer
# relevant Preparing event)
  field(CALC, "A == 2 && B == 1")
  field(INPA, "Timing:TriggerGeneration:Status")
  field(INPB, "TakeNShots:PreparingTimeout:NumTimersRunning")
  field(OUT, "TakeNShots:PreparingTimeout:HasTimedOut")
  field(DOPT, "Use CALC")
# Decrement number of timers running
  field(FLNK, "TakeNShots:PreparingTimeout:DecrementNumTimersRunning")
}

record(seq, TakeNShots:PreparingTimeout:StartTimer) {
# reset HasTimedOut
  field(DOL0, "0")
  field(LNK0, "TakeNShots:PreparingTimeout:HasTimedOut")
# start timer: schedule a check after timeout period
  field(DLY1, "10")
  field(DOL1, "1")
  field(LNK1, "TakeNShots:PreparingTimeout:Check.PROC")
# increment number of timers
  field(LNK2, "TakeNShots:PreparingTimeout:IncrementNumTimersRunning.PROC")
}

record(longout, TakeNShots:PreparingTimeout:NumTimersRunning) {
  field(VAL, "0")
}

record(calcout, TakeNShots:PreparingTimeout:IncrementNumTimersRunning) {
  field(CALC, "A + 1")
  field(INPA, "TakeNShots:PreparingTimeout:NumTimersRunning.VAL")
  field(OUT, "TakeNShots:PreparingTimeout:NumTimersRunning.VAL")
}

record(calcout, TakeNShots:PreparingTimeout:DecrementNumTimersRunning) {
  field(CALC, "A - 1")
  field(INPA, "TakeNShots:PreparingTimeout:NumTimersRunning.VAL")
  field(OUT, "TakeNShots:PreparingTimeout:NumTimersRunning.VAL")
}

