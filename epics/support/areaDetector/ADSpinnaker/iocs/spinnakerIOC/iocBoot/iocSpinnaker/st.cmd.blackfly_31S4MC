< envPaths
errlogInit(20000)

dbLoadDatabase("$(TOP)/dbd/spinnakerApp.dbd")
spinnakerApp_registerRecordDeviceDriver(pdbbase) 


# Common to all cameras
#################################################################################################################################################
# Prefix for all records
epicsEnvSet("PREFIX", "ut3daq:")

# Really large queue so we can stream to disk at full camera speed
epicsEnvSet("QSIZE",  "2000")   
# The maximim image width; used for row profiles in the NDPluginStats plugin
epicsEnvSet("XSIZE",  "2048")
# The maximim image height; used for column profiles in the NDPluginStats plugin
epicsEnvSet("YSIZE",  "1536")
# The maximum number of time series points in the NDPluginStats plugin
epicsEnvSet("NCHANS", "2048")
# The maximum number of frames buffered in the NDPluginCircularBuff plugin
epicsEnvSet("CBUFFS", "500")
# The search path for database files
epicsEnvSet("EPICS_DB_INCLUDE_PATH", "$(ADCORE)/db:$(ADGENICAM)/db:$(ADSPINNAKER)/db")
# Define NELEMENTS to be enough for a 2048x1536x1 monochrome image
epicsEnvSet("NELEMENTS", "3145728")

# Settings for Electron Spectrometer Front Screen Camera
#################################################################################################################################################
ADSpinnakerConfig("ESPEC_FRONT_CAM", "20541743")
asynSetTraceIOMask(ESPEC_FRONT_CAM, 0, 2)
dbLoadRecords("$(ADGENICAM)/db/espec_front_cam.template", "P=$(PREFIX),R=espec_front_cam:,PORT=ESPEC_FRONT_CAM")
dbLoadRecords("$(ADSPINNAKER)/db/spinnaker.template", "P=$(PREFIX),R=espec_front_cam:,PORT=ESPEC_FRONT_CAM")

# Create a standard arrays plugin
NDStdArraysConfigure("Image_ESpec_Front", 5, 0, "ESPEC_FRONT_CAM", 0, 0)
# Use this line for 8-bit or 16-bit data
dbLoadRecords("$(ADCORE)/db/NDStdArrays.template", "P=$(PREFIX),R=img_espec_front:,PORT=Image_ESpec_Front,ADDR=0,TIMEOUT=1,NDARRAY_PORT=ESPEC_FRONT_CAM,TYPE=Int16,FTVL=SHORT,NELEMENTS=$(NELEMENTS)")

# Settings for Electron Spectrometer Back Screen Camera
#################################################################################################################################################
ADSpinnakerConfig("ESPEC_BACK_CAM", "20541743")
asynSetTraceIOMask(ESPEC_BACK_CAM, 0, 2)
dbLoadRecords("$(ADGENICAM)/db/espec_back_cam.template", "P=$(PREFIX),R=espec_back_cam:,PORT=ESPEC_BACK_CAM")
dbLoadRecords("$(ADSPINNAKER)/db/spinnaker.template", "P=$(PREFIX),R=espec_back_cam:,PORT=ESPEC_BACK_CAM")

# Create a standard arrays plugin
NDStdArraysConfigure("Image_ESpec_Back", 5, 0, "ESPEC_BACK_CAM", 0, 0)
# Use this line for 8-bit or 16-bit data
dbLoadRecords("$(ADCORE)/db/NDStdArrays.template", "P=$(PREFIX),R=img_espec_back:,PORT=Image_ESpec_Back,ADDR=0,TIMEOUT=1,NDARRAY_PORT=ESPEC_BACK_CAM,TYPE=Int16,FTVL=SHORT,NELEMENTS=$(NELEMENTS)")

# Settings for Electron Pointing Screen Camera
#################################################################################################################################################
ADSpinnakerConfig("EPOINTING_CAM", "20057635")
asynSetTraceIOMask(EPOINTING_CAM, 0, 2)
dbLoadRecords("$(ADGENICAM)/db/epointing_cam.template", "P=$(PREFIX),R=epointing_cam:,PORT=EPOINTING_CAM")
dbLoadRecords("$(ADSPINNAKER)/db/spinnaker.template", "P=$(PREFIX),R=epointing_cam:,PORT=EPOINTING_CAM")

# Create a standard arrays plugin
NDStdArraysConfigure("Image_EPointing", 5, 0, "EPOINTING_CAM", 0, 0)
# Use this line for 8-bit or 16-bit data
dbLoadRecords("$(ADCORE)/db/NDStdArrays.template", "P=$(PREFIX),R=img_epointing:,PORT=Image_EPointing,ADDR=0,TIMEOUT=1,NDARRAY_PORT=EPOINTING_CAM,TYPE=Int16,FTVL=SHORT,NELEMENTS=$(NELEMENTS)")

# Starting common plugins and start IOC
#################################################################################################################################################
# Load all other plugins using commonPlugins.cmd
< $(ADCORE)/iocBoot/commonPlugins.cmd
set_requestfile_path("$(ADGENICAM)/GenICamApp/Db")
set_requestfile_path("$(ADSPINNAKER)/spinnakerApp/Db")

iocInit()

# save things every thirty seconds
create_monitor_set("auto_settings.req", 30,"P=$(PREFIX)")

# Wait for enum callbacks to complete
epicsThreadSleep(1.0)

# Wait for callbacks on the property limits (DRVL, DRVH) to complete
epicsThreadSleep(1.0)


